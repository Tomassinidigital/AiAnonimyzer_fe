# Base URL delle API del backend FastAPI.
# Per i test locali punta all'istanza uvicorn (default :8000).
# In produzione: l'URL pubblico del backend (es. https://api.example.com).
VITE_API_BASE_URL=http://localhost:8000

# --- Area utente / lista d'attesa (pagina #account) ---
# Endpoint che riceve le iscrizioni (POST JSON: name, email, organization,
# plan, created_at). Se vuoto si usa il fallback mailto: qui sotto.
VITE_WAITLIST_URL=
# Fallback: indirizzo a cui inviare l'iscrizione via client di posta.
# Se entrambe le variabili sono vuote il modulo resta disabilitato.
VITE_WAITLIST_EMAIL=
